# Copy to .env. Every setting has the CC_ prefix; see src/crashcase/config.py for all of them.

# Models: "stub" works with no weights. Switch to "yolo" once models/damage-seg.pt exists
# (and build the image with INSTALL_ML=true).
CC_DETECTOR_BACKEND=stub
CC_EMBEDDER_BACKEND=histogram

# Free Llama 3.1 key from https://console.groq.com. Leave empty for template reports.
CC_LLM_API_KEY=
CC_LLM_MODEL=llama-3.1-8b-instant
CC_PROMPT_VERSION=v1

# Postgres password used by docker-compose
POSTGRES_PASSWORD=crashcase
GRAFANA_PASSWORD=admin
